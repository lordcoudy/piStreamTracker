flowchart LR
  %% Detailed frame-processing and control flow shared by CLI and web modes.
  START["CLI main or TrackerLifecycle"] --> INIT["HumanTracker.__init__<br/>config, detector, object tracker, motors"]
  INIT --> CONNECT["connect()<br/>start capture, learn frame size, start async detector"]
  CONNECT --> LOOP

  subgraph MAIN["Per-frame loop"]
    LOOP["Read latest frame"] --> GATE{"accept_new_frame()?"}
    GATE -->|"duplicate / too soon"| LOOP
    GATE -->|"accepted"| PROCESS["process_frame(frame)"]

    PROCESS --> POLL{"Fresh async result?"}
    POLL -->|"person detected"| MATCH{"IoU matches current target?"}
    MATCH -->|"yes, or no active target"| TRACK_INIT["ObjectTracker.init(bbox)"]
    MATCH -->|"different target"| KEEP["Keep current tracker"]
    POLL -->|"no person"| MISS["Increment detection misses"]
    MISS -->|"miss limit reached"| DROP["Drop stale tracker"]
    MISS -->|"below limit"| KEEP

    TRACK_INIT --> SUBMIT
    KEEP --> SUBMIT
    DROP --> SUBMIT
    POLL -->|"no completed result"| SUBMIT

    SUBMIT{"Detection due and worker idle?"} -->|"yes"| QUEUE["Copy scaled frame to async worker"]
    SUBMIT -->|"no"| UPDATE
    QUEUE --> UPDATE["ObjectTracker.update(frame)"]

    UPDATE --> TARGET{"Tracked target available?"}
    TARGET -->|"yes"| AIM["Aim at upper torso<br/>compute normalized x/y shift"]
    AIM --> MOTOR["MotorController.update(x, y)"]
    TARGET -->|"no"| STOP_MOTOR["MotorController.stop()"]

    MOTOR --> DRAW["Draw box, keypoints and status"]
    STOP_MOTOR --> DRAW
    DRAW --> HORIZON{"Horizon correction enabled?"}
    HORIZON -->|"yes"| ROTATE["Rotate and crop using calibrated angle"]
    HORIZON -->|"no"| ZOOM
    ROTATE --> ZOOM["Apply digital zoom"]
    ZOOM --> OUTPUT["Return annotated frame"]
  end

  subgraph DETECT["Async pose-detection worker"]
    QUEUE --> PREP["Resize, BGR → RGB, fill reusable input tensor"]
    PREP --> INFER["TFLite interpreter.invoke()"]
    INFER --> PARSE["Parse confident keypoints and person bbox"]
    PARSE --> PUBLISH["Publish latest result"]
    PUBLISH -.-> POLL
  end

  subgraph DRIVE["EV3 motor control"]
    MOTOR --> RATE{"Cooldown elapsed?"}
    RATE -->|"no"| HOLD["Keep current command"]
    RATE -->|"yes"| POLICY["compute_axis_command()<br/>dead zone, gain, limits"]
    POLICY --> USB["EV3_USB.run_to() / stop()"]
    USB --> PHYSICAL["Horizontal + vertical motors"]
    STOP_MOTOR --> USB
  end

  subgraph PRESENT["Presentation"]
    OUTPUT -->|"CLI"| DISPLAY["cv2.imshow, or headless skip"]
    OUTPUT -->|"web"| SHARED["Thread-safe latest-frame buffer"]
    SHARED --> MJPEG["/video_feed annotated MJPEG"]
    RAW["Camera /stream"] --> PROXY["/video_feed raw proxy"]
  end

  subgraph RECORD["Recording control"]
    REC_TOGGLE["CLI key or web API"] --> REC_MODE{"Configured backend"}
    REC_MODE -->|"camera"| CAM_API["Camera /record/start or /record/stop"]
    CAM_API -->|"request fails and fallback is enabled"| LOCAL["_RecordingThread"]
    REC_MODE -->|"local"| LOCAL
    LOOP -.->|"copy accepted source frame"| LOCAL
    LOCAL --> ENCODER{"Available encoder"}
    ENCODER -->|"preferred"| FFMPEG["ffmpeg H.264"]
    ENCODER -->|"fallback"| OPENCV["OpenCV MJPG"]
  end

  EXIT["Stop request, q, signal or failure"] --> CLEANUP["cleanup()"]
  CLEANUP --> C1["Stop async detector"]
  CLEANUP --> C2["Disconnect motors"]
  CLEANUP --> C3["Stop recording and capture"]
  CLEANUP --> C4["Flush shift log and close windows"]

  LOOP -.-> EXIT

  classDef lifecycle fill:#fff7ed,stroke:#c2410c,color:#431407
  classDef frame fill:#eff6ff,stroke:#1d4ed8,color:#172554
  classDef worker fill:#ecfeff,stroke:#0e7490,color:#083344
  classDef motor fill:#f5f3ff,stroke:#6d28d9,color:#2e1065
  classDef record fill:#f0fdf4,stroke:#15803d,color:#052e16
  classDef shutdown fill:#fef2f2,stroke:#b91c1c,color:#450a0a

  class START,INIT,CONNECT lifecycle
  class LOOP,GATE,PROCESS,POLL,MATCH,TRACK_INIT,KEEP,MISS,DROP,SUBMIT,UPDATE,TARGET,AIM,STOP_MOTOR,DRAW,HORIZON,ROTATE,ZOOM,OUTPUT frame
  class QUEUE,PREP,INFER,PARSE,PUBLISH worker
  class MOTOR,RATE,HOLD,POLICY,USB,PHYSICAL motor
  class REC_TOGGLE,REC_MODE,CAM_API,LOCAL,ENCODER,FFMPEG,OPENCV record
  class EXIT,CLEANUP,C1,C2,C3,C4 shutdown
